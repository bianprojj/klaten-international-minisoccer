generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Enums for application-level type safety (stored as VARCHAR in DB)
enum AdminRole {
  super_admin
  manager
  staff
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  rescheduled
  completed
  expired
  refunded
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
  expired
  cancelled
}

enum PaymentMethod {
  Midtrans
  QRIS
  GoPay
  Dana
  ShopeePay
  OVO
  BCA
  BNI
  Mandiri
  Offline
}

enum InvoiceStatus {
  issued
  paid
  cancelled
  refunded
}

// `Field` model removed: application is single-venue and no longer stores per-field data in DB.

// FieldSchedule removed; availability derived from bookings/payments.

// TimeSlot model removed (not used in single-venue setup).

// ScheduleBlock removed (use Booking.status for blocked slots if needed).

model Booking {
  id            String        @id @default(uuid()) @map("id")
  bookingDate   DateTime      @map("booking_date")
  startTime     String        @map("start_time")
  endTime       String        @map("end_time")
  durationHours Int           @map("duration_hours")
  totalPrice    Int           @map("total_price")
  customerName  String        @map("customer_name")
  customerPhone String        @map("customer_phone")
  customerEmail String?       @map("customer_email")
  status        String        @default("pending") @map("status")
  notes         String?       @map("notes")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  payments Payment[]
  invoice  Invoice?
  reviews  Review[]

  @@unique([bookingDate, startTime], map: "booking_booking_date_start_time_key")
  @@map("booking")
}

model Payment {
  id              String   @id @default(uuid()) @map("id")
  bookingId       String   @map("booking_id")
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionId   String   @unique @map("transaction_id")
  midtransOrderId String?  @unique @map("midtrans_order_id")
  snapToken       String?  @map("snap_token")
  snapUrl         String?  @map("payment_link_url")
  amount          Int      @map("amount")
  paymentMethod   String   @default("Midtrans") @map("payment_method")
  provider        String   @default("Midtrans") @map("provider")
  status          String   @default("pending") @map("status")
  paidAt          DateTime? @map("paid_at")
  expiredAt       DateTime? @map("expired_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  invoice Invoice?

  @@map("payment")
}

model Invoice {
  id            String       @id @default(uuid()) @map("id")
  invoiceNumber String       @unique @map("invoice_number")
  bookingId     String       @unique @map("booking_id")
  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId     String       @unique @map("payment_id")
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  customerName  String?      @map("customer_name")
  customerEmail String?      @map("customer_email")
  customerPhone String?      @map("customer_phone")
  subtotal      Int          @map("subtotal")
  tax           Int          @default(0) @map("tax")
  discount      Int          @default(0) @map("discount")
  adminFee      Int          @default(0) @map("admin_fee")
  total         Int          @map("total")
  status        String       @default("issued") @map("status")
  issuedAt      DateTime     @default(now()) @map("issued_at")
  paidAt        DateTime?    @map("paid_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("invoice")
}

model ReferralCode {
  id          String   @id @default(uuid()) @map("id")
  code        String   @unique @map("code")
  name        String   @map("name")
  type        String   @default("percent") @map("type") // "percent" | "fixed"
  value       Int      @map("value")                  // persen (10 = 10%) atau nominal (20000 = Rp20k)
  maxUses     Int?     @map("max_uses")               // null = unlimited
  usedCount   Int      @default(0) @map("used_count")
  validFrom   DateTime @default(now()) @map("valid_from")
  validUntil  DateTime? @map("valid_until")           // null = no expiry
  isActive    Boolean  @default(true) @map("is_active")
  adminFee    Int      @default(0) @map("admin_fee")  // biaya admin tambahan jika pakai kode ini
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  usages      ReferralUsage[]

  @@map("referral_code")
}

model ReferralUsage {
  id              String       @id @default(uuid()) @map("id")
  referralCodeId  String       @map("referral_code_id")
  referralCode    ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  bookingId       String       @unique @map("booking_id")
  discountAmount  Int          @map("discount_amount")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@map("referral_usage")
}

model Review {
  id           String    @id @default(uuid()) @map("id")
  bookingId    String?   @map("booking_id")
  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerName String    @map("customer_name")
  rating       Int       @map("rating")
  comment      String    @map("comment")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("review")
}

model ScheduleSlot {
  id        String   @id @default(uuid()) @map("id")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  price     Int      @default(0) @map("price")
  dayOfWeek String   @default("mon,tue,wed,thu,fri,sat,sun") @map("day_of_week")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("schedule_slot")
}

model AuditLog {
  id             String   @id @default(uuid()) @map("id")
  action         String   @map("action")
  entity         String   @map("entity")
  entityId       String   @map("entity_id")
  changes        String?  @map("changes")
  ipAddress      String?  @map("ip_address")
  referenceEmail String?  @map("reference_email")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model AdminSetting {
  id          String   @id @default(uuid()) @map("id")
  key         String   @unique @map("key")
  value       String   @map("value")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("admin_setting")
}

model AdminUser {
  id             String   @id @default(uuid()) @map("id")
  name           String   @map("name")
  email          String   @unique @map("email")
  passwordHash   String   @map("password_hash")
  role           String   @default("staff") @map("role")
  isActive       Boolean  @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  sessions AdminSession[]

  @@map("admin_user")
}

model AdminSession {
  id          String    @id @default(uuid()) @map("id")
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("admin_session")
}

model VenueFeature {
  id            String   @id @default(uuid()) @map("id")
  name          String   @map("name")
  description   String   @map("description")
  imageUrl      String   @map("image_url")
  imagePublicId String?  @map("image_public_id")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("venue_feature")
}

model VenueGallery {
  id            String   @id @default(uuid()) @map("id")
  title         String   @map("title")
  imageUrl      String   @map("image_url")
  imagePublicId String?  @map("image_public_id")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("venue_gallery")
}

model WebhookEvent {
  id         String   @id @default(uuid()) @map("id")
  eventHash  String   @unique @map("event_hash")
  orderId    String?  @map("order_id")
  eventType  String?  @map("event_type")
  payload    Json     @map("payload")
  processed  Boolean  @default(false) @map("processed")
  processedAt DateTime? @map("processed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("webhook_event")
}