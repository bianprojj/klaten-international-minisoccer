generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  super_admin
  manager
  staff
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  rescheduled
  completed
  expired
  refunded
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
  expired
  cancelled
}

enum PaymentMethod {
  Midtrans
  QRIS
  GoPay
  Dana
  ShopeePay
  OVO
  BCA
  BNI
  Mandiri
  Offline
}

enum InvoiceStatus {
  issued
  paid
  cancelled
  refunded
}

// `Field` model removed: application is single-venue and no longer stores per-field data in DB.

// FieldSchedule removed; availability derived from bookings/payments.

// TimeSlot model removed (not used in single-venue setup).

// ScheduleBlock removed (use Booking.status for blocked slots if needed).

model Booking {
  id            String        @id @default(uuid()) @map("id")
  // approvedById and approvedBy removed to match production DB (column not present)
  bookingDate   DateTime      @map("booking_date")
  startTime     String        @map("start_time")
  endTime       String        @map("end_time")
  durationHours Int           @map("duration_hours")
  totalPrice    Int           @map("total_price")
  customerName  String        @map("customer_name")
  customerPhone String        @map("customer_phone")
  customerEmail String?       @map("customer_email")
  status        BookingStatus @default(pending) @map("status")
  notes         String?       @map("notes")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  payments Payment[]
  invoice  Invoice?
  reviews  Review[]

  // Active-slot uniqueness is enforced by a partial DB index in migration SQL so
  // expired/cancelled/refunded records can be reclaimed without blocking new bookings.
  @@map("booking")
}

model Payment {
  id              String        @id @default(uuid()) @map("id")
  bookingId       String        @map("booking_id")
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactionId   String        @unique @map("transaction_id")
  midtransOrderId String?       @unique @map("midtrans_order_id")
  snapToken       String?       @map("snap_token")
  snapUrl         String?       @map("payment_link_url")
  amount          Int           @map("amount")
  paymentMethod   PaymentMethod @default(Midtrans) @map("payment_method")
  provider        String        @default("Midtrans") @map("provider")
  status          PaymentStatus @default(pending) @map("status")
  paidAt          DateTime?     @map("paid_at")
  expiredAt       DateTime?     @map("expired_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  invoice Invoice?

  @@map("payment")
}

model Invoice {
  id            String        @id @default(uuid()) @map("id")
  invoiceNumber String        @unique @map("invoice_number")
  bookingId     String        @unique @map("booking_id")
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentId     String        @unique @map("payment_id")
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  customerName  String?       @map("customer_name")
  customerEmail String?       @map("customer_email")
  customerPhone String?       @map("customer_phone")
  subtotal      Int           @map("subtotal")
  tax           Int           @default(0) @map("tax")
  discount      Int           @default(0) @map("discount")
  total         Int           @map("total")
  status        InvoiceStatus @default(issued) @map("status")
  issuedAt      DateTime      @default(now()) @map("issued_at")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("invoice")
}

model Review {
  id           String   @id @default(uuid()) @map("id")
  bookingId    String?  @map("booking_id")
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerName String   @map("customer_name")
  rating       Int      @map("rating")
  comment      String   @map("comment")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("review")
}

model ScheduleSlot {
  id        String   @id @default(uuid()) @map("id")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  price     Int      @default(0) @map("price")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("schedule_slot")
}

model AuditLog {
  id             String   @id @default(uuid()) @map("id")
  action         String   @map("action")
  entity         String   @map("entity")
  entityId       String   @map("entity_id")
  changes        String?  @map("changes")
  ipAddress      String?  @map("ip_address")
  referenceEmail String?  @map("reference_email")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model AdminSetting {
  id          String   @id @default(uuid()) @map("id")
  key         String   @unique @map("key")
  value       String   @map("value")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("admin_setting")
}

model AdminUser {
  id           String    @id @default(uuid()) @map("id")
  name         String    @map("name")
  email        String    @unique @map("email")
  passwordHash String    @map("password_hash")
  role         AdminRole @default(staff) @map("role")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions AdminSession[]

  @@map("admin_user")
}

model AdminSession {
  id          String    @id @default(uuid()) @map("id")
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("admin_session")
}

model VenueFeature {
  id            String   @id @default(uuid()) @map("id")
  name          String   @map("name")
  description   String   @map("description")
  imageUrl      String   @map("image_url")
  imagePublicId String?  @map("image_public_id")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("venue_feature")
}

model VenueGallery {
  id            String   @id @default(uuid()) @map("id")
  title         String   @map("title")
  imageUrl      String   @map("image_url")
  imagePublicId String?  @map("image_public_id")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("venue_gallery")
}

/// Webhook events table to record incoming payment provider notifications and
/// prevent duplicate processing. This is used by the payments webhook route to
/// ensure idempotency and for auditing.
model WebhookEvent {
  id         String   @id @default(uuid()) @map("id")
  eventHash  String   @unique @map("event_hash")
  orderId    String?  @map("order_id")
  eventType  String?  @map("event_type")
  payload    Json     @map("payload")
  processed  Boolean  @default(false) @map("processed")
  processedAt DateTime? @map("processed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("webhook_event")
}
